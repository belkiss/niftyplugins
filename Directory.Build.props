<Project>
  <PropertyGroup>
    <Copyright>Copyright (C) 2006-2017 Jim Tilander, 2017-2026 Lambert Clara. See COPYING for and README for more details.</Copyright>
    <Authors>Jim Tilander, Lambert Clara, NiftyPerforce contributors</Authors>

    <LangVersion>8.0</LangVersion>
    <TargetFramework>net472</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors Condition="'$(Configuration)'=='Release' OR '$(Configuration)'=='Release Legacy'">true</TreatWarningsAsErrors>
    <ImplicitUsings>disable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)StyleCop.json" Link="StyleCop.json" />
  </ItemGroup>

  <ItemGroup>
    <SourceRoot Include="$(MSBuildThisFileDirectory)/"/>
  </ItemGroup>
</Project>
